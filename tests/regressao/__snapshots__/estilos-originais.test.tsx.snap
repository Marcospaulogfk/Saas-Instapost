</div>
<div data-edit="block" data-edit-key="blk-marca" data-block-type="brand" class="absolute" style="left:100px;top:460px;width:220px;height:44px;opacity:1;transform-origin:center">
<div class="w-full h-full flex items-center gap-2.5 overflow-hidden f" style="color:#FFFFFF">
<div class="leading-tight min-w-0">
<div class="flex items-center gap-1">
